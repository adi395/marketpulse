# Copy to .env and fill in your own free API keys.
# Finnhub (quotes, fundamentals, news, earnings, filings): https://finnhub.io
FINNHUB_API_KEY=your-finnhub-key
# Alpha Vantage (historical price charts): https://www.alphavantage.co
ALPHAVANTAGE_API_KEY=your-alphavantage-key

# Local (non-Docker) backend database connection. Defaults in
# application.properties point at a local Postgres named "marketpulse".
DB_USERNAME=postgres
DB_PASSWORD=
